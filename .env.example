# ==============================================================================
# Environment Configuration for CT Spleen Volumetry API
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Model Weights Checkpoint
MODEL_PATH=/app/models/best.pth

# Set to 1 to enable lightweight CPU mock inference without weights
MOCK_INFERENCE=0

# Runtime optimization
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHONPATH=/app
